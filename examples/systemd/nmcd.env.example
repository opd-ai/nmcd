# nmcd environment variables
#
# This file demonstrates secure credential management using environment variables.
# Place this file at /etc/nmcd/nmcd.env for systemd service, or source it in your shell.
#
# IMPORTANT: Set restrictive permissions on this file:
#   chmod 600 /etc/nmcd/nmcd.env
#   chown root:root /etc/nmcd/nmcd.env
#
# Supported environment variables:
#   NMCD_RPC_USER       - RPC authentication username
#   NMCD_RPC_PASSWORD   - RPC authentication password
#   NMCD_RPC_ADDR       - RPC server listen address
#   NMCD_PROMETHEUS_ADDR - Prometheus metrics endpoint
#   NMCD_NETWORK        - Network type (mainnet, testnet, regtest)
#   NMCD_DATADIR        - Data directory path

# RPC authentication
NMCD_RPC_USER=your_rpc_username
NMCD_RPC_PASSWORD=your_secure_rpc_password

# Optional: Override other settings
# NMCD_RPC_ADDR=127.0.0.1:8336
# NMCD_NETWORK=mainnet
# NMCD_DATADIR=/var/lib/nmcd
# NMCD_PROMETHEUS_ADDR=127.0.0.1:9090
